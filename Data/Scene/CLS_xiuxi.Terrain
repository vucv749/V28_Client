<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Terrain name="CLS_xiuxi" tileSize="32" xsize="256" zsize="256">

  <scale x="100" y="100" z="100"/>

  <centre x="-9600" y="0" z="9600"/>

  <heightmap filename="CLS_xiuxi.Heightmap" type="standard"/>

  <gridInfo filename="CLS_xiuxi.GridInfo" type="standard"/>

  <useColorMap useColorMap="true"/>

  <colorMap filename="CLS_xiuxiColor.tga"/>

  <useColorMapAlphaBlend useColorMapAlphaBlend="true"/>

  <textures>
    <texture filename="室内/HJ_宋辽战场休息室_大地砖.jpg" type="image"/>
  </textures>

  <pixmaps>
    <pixmap bottom="0.25" left="0" right="0.25" textureId="0" top="0"/>
    <pixmap bottom="0.5" left="0" right="0.25" textureId="0" top="0.25"/>
    <pixmap bottom="0.75" left="0" right="0.25" textureId="0" top="0.5"/>
    <pixmap bottom="1" left="0" right="0.25" textureId="0" top="0.75"/>
    <pixmap bottom="0.25" left="0.25" right="0.5" textureId="0" top="0"/>
    <pixmap bottom="0.5" left="0.25" right="0.5" textureId="0" top="0.25"/>
    <pixmap bottom="0.75" left="0.25" right="0.5" textureId="0" top="0.5"/>
    <pixmap bottom="1" left="0.25" right="0.5" textureId="0" top="0.75"/>
    <pixmap bottom="0.25" left="0.5" right="0.75" textureId="0" top="0"/>
    <pixmap bottom="0.5" left="0.5" right="0.75" textureId="0" top="0.25"/>
    <pixmap bottom="0.75" left="0.5" right="0.75" textureId="0" top="0.5"/>
    <pixmap bottom="1" left="0.5" right="0.75" textureId="0" top="0.75"/>
    <pixmap bottom="0.25" left="0.75" right="1" textureId="0" top="0"/>
    <pixmap bottom="0.5" left="0.75" right="1" textureId="0" top="0.25"/>
    <pixmap bottom="0.75" left="0.75" right="1" textureId="0" top="0.5"/>
    <pixmap bottom="1" left="0.75" right="1" textureId="0" top="0.75"/>
  </pixmaps>

  <materials>
    <template material="Terrain/OneLayerColorMap" name="OneLayer"/>
    <template material="Terrain/OneLayerLightmapColorMap" name="OneLayerLightmap"/>
    <template material="Terrain/TwoLayerColorMapAlphaBlend" name="TwoLayer"/>
    <template material="Terrain/TwoLayerLightmapColorMapAlphaBlend" name="TwoLayerLightmap"/>
    <fog_replacement exp="Terrain/OneLayer_ps%fog_exp" exp2="Terrain/OneLayer_ps%fog_exp2" linear="Terrain/OneLayer_ps%fog_linear" none="Terrain/OneLayer_ps"/>
    <fog_replacement exp="Terrain/TwoLayer_ps%fog_exp" exp2="Terrain/TwoLayer_ps%fog_exp2" linear="Terrain/TwoLayer_ps%fog_linear" none="Terrain/TwoLayer_ps"/>
    <fog_replacement exp="Terrain/OneLayerLightmap_ps%fog_exp" exp2="Terrain/OneLayerLightmap_ps%fog_exp2" linear="Terrain/OneLayerLightmap_ps%fog_linear" none="Terrain/OneLayerLightmap_ps"/>
    <fog_replacement exp="Terrain/TwoLayerLightmap_ps%fog_exp" exp2="Terrain/TwoLayerLightmap_ps%fog_exp2" linear="Terrain/TwoLayerLightmap_ps%fog_linear" none="Terrain/TwoLayerLightmap_ps"/>
  </materials>

</Terrain>
