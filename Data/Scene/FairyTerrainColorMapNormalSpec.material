material Terrain/OneLayerColorMapNormalSpec
{
    // fragment program, for compatible with other material

    technique
    {
        pass
        {        
        		vertex_program_ref Terrain/OneLayerColormapNormalSpec_vs
						{
						}
		        fragment_program_ref Terrain/OneLayerColorMapNormalSpec_ps
            {
            }

            texture_unit
            {
                texture_alias <layer0>
                texture <layer0>
                //tex_address_mode wrap
                tex_coord_set 0
            }
            
            texture_unit
            {                        
                texture_alias <colorMap>
                texture <colorMap>
                tex_address_mode clamp
                tex_coord_set 7
                sampler_index 3
            }

						texture_unit
				    {
								texture_alias <normalspec0>
			          texture <normalspec0>
								tex_coord_set 0
								sampler_index 6
				    }
        }
    }

    technique
    {
    		lod_index 1
        pass
        {        
        		vertex_program_ref Terrain/OneLayerColormap_vs
						{
						}
		        fragment_program_ref Terrain/OneLayerColorMapLut_ps
            {
            }

            texture_unit
            {
                texture_alias <layer0>
                texture <layer0>
                //tex_address_mode wrap
                tex_coord_set 0
            }
            
            texture_unit
            {                        
                texture_alias <colorMap>
                texture <colorMap>
                tex_address_mode clamp
                tex_coord_set 7
                sampler_index 3
            }
            
            texture_unit
            {                        
                texture luttex.png
                tex_address_mode clamp
                filtering none
                sampler_index 4
            }
        }
    }
    
    technique
		{
			scheme Depth
			pass
			{
				fog_override true none

				vertex_program_ref CartoonEffect/VS/DrawDepth_NoTex
				{
				}
				fragment_program_ref CartoonEffect/PS/DrawDepth_NoTex
				{
				}
			}
		}
}

