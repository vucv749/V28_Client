material Terrain/TwoLayerColorMapNormalSpec
{
    // fragment program for DirectX only, test on GeForce FX 5700LE, performance boost %5

    technique
    {
        pass
        {
        		vertex_program_ref Terrain/TwoLayerColormapNormalSpec_vs
						{
						}
            fragment_program_ref Terrain/TwoLayerColorMapNormalSpec_ps
            {
            }

            texture_unit
            {
                texture_alias <layer0>
                texture <layer0>
                //tex_address_mode wrap
            }

            texture_unit
            {
                texture_alias <layer1>
                texture <layer1>
                //tex_address_mode wrap
                tex_coord_set 1
            }
            
            texture_unit
            {
                texture_alias <colorMap>
                texture <colorMap>
                tex_address_mode clamp
                tex_coord_set 7
                sampler_index 3
            }

						texture_unit
				    {
								texture_alias <normalspec0>
			          texture <normalspec0>
								tex_coord_set 0
								sampler_index 6
				    }
				    
				    texture_unit
				    {
								texture_alias <normalspec1>
			          texture <normalspec1>
								tex_coord_set 1
								sampler_index 7
				    }
        }
    }

    technique
    {
        lod_index 1
        pass
        {
        		vertex_program_ref Terrain/TwoLayerColormap_vs
						{
						}
            fragment_program_ref Terrain/TwoLayerColorMapLut_ps
            {
            }

            texture_unit
            {
                texture_alias <layer0>
                texture <layer0>
                //tex_address_mode wrap
            }

            texture_unit
            {
                texture_alias <layer1>
                texture <layer1>
                //tex_address_mode wrap
                tex_coord_set 1
            }
            
            texture_unit
            {
                texture_alias <colorMap>
                texture <colorMap>
                tex_address_mode clamp
                tex_coord_set 7
                sampler_index 3
            }
            
            texture_unit
            {                        
                texture luttex.png
                tex_address_mode clamp
                filtering none
                sampler_index 4
            }
        }
    }
    
    technique
		{
			scheme Depth
			pass
			{
				fog_override true none

				vertex_program_ref CartoonEffect/VS/DrawDepth_NoTex
				{
				}
				fragment_program_ref CartoonEffect/PS/DrawDepth_NoTex
				{
				}
			}
		}
}

