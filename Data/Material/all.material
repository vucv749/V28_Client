material npc_2024情人节狼人 : Mtl_Character_FlowLight
{
	technique
	{
		pass
		{
			emissive 0.500000 0.500000 0.500000   
			fragment_program_ref Character_FlowLight
			{
				param_named flowFactor float4 2.0 -2.0 0 -4
			}
        }
    }
