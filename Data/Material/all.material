material 雁北_树木03:  LSTree 
{
	technique
	{
		pass
		{
			emissive 0.2 0.2 0.2 1
      vertex_program_ref Model_VsAnimation_VS
		{
	    param_named vsAniFactor float4 70 7 1 70
      param_named vsWindStrength float 10
		 }
		}
	}
		 set_texture_alias <baseTexture> 雁北/tga_雁北_树木03.dds

}

