material 骑乘240326黄金马亮片 : Mtl_Model_TwoTex_Tex2_ColorX4

{
	set_texture_alias <baseTexture> jpg_骑乘240326黄金马亮片蒙版.dds
	set_texture_alias <scrollTex> png_骑乘240326黄金马亮片纹理.dds
	technique
	{
		pass
		{
		   emissive 0.500000 0.500000 0.500000
                    fog_override true none
			scene_blend add
			depth_write off
			texture_unit scrollTex

			{
					scroll 0.47 0.0
					scroll_anim 0.8 0
			}
			
		}
	}
}
material 骑乘240326黄金马暗片 : Mtl_Model_TwoTex_Tex2_ColorX4

