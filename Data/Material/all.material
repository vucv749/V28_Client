material buff_重楼腰_1 : Mtl_Particle
{
	set_texture_alias <baseTexture> jpg_aaay.dds
}
material buff_重楼腰带免控_1 : Mtl_Particle_TwoTex_Tex1_ColorX4
{
	set_texture_alias <baseTexture> jpg_z_xuanwudunpai01.dds
	set_texture_alias <scrollTex> jpg_wyg_通用遮罩1.dds
	technique
	{
		pass
		{
			scene_blend one one_minus_src_colour
			depth_write off
			texture_unit
			{
				tex_address_mode clamp
			}
			texture_unit scrollTex
			{
				tex_address_mode clamp
			}
		}
	}
}
material buff_重楼腰带免控_2 : Mtl_Particle_TwoTex_Tex1_ColorX2
{
	set_texture_alias <baseTexture> jpg_蒙版014.dds
	set_texture_alias <scrollTex> png_202208拖尾06.dds
	technique
	{
		pass
		{
			scene_blend src_alpha one
			depth_write off
			texture_unit
			{
					scale 1 0.5
					scroll 0 1.56415
					scroll_anim 0 0.15
			}
			texture_unit scrollTex
			{
					scale 2 0.5
					scroll 0 1.1059
					scroll_anim 0 -1
			}
		}
	}
}

