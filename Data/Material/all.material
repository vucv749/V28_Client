material 男主角新清风怡江 : Mtl_Character_FlowLight
{
	technique
	{
		pass
		{
			emissive 0.500000 0.500000 0.500000   
			fragment_program_ref Character_FlowLight
			{
				param_named flowFactor float4 2.0 2.0 0 6
			}
        }
    }
	set_texture_alias <baseTexture> tga_男主角新清风怡江.dds
	set_texture_alias <ctlTex> jpg_男主角新清风怡江遮罩.dds 
	set_texture_alias <_Reflection> jpg_主角新清风怡江流光.dds
}
material 男主角新飞龙乘云时装 : Mtl_Character_FlowLight
{
	technique
	{
		pass
		{
			emissive 0.500000 0.500000 0.500000   
			fragment_program_ref Character_FlowLight
			{
				param_named flowFactor float4 -2.0 3.0 0 5
			}
        }
    }
	set_texture_alias <baseTexture> tga_男主角新飞龙乘云时装.dds
	set_texture_alias <ctlTex> jpg_男主角新飞龙乘云时装遮罩.dds 
	set_texture_alias <_Reflection> jpg_主角新飞龙乘云时装流光.dds
}

material 男主角新飞龙乘云时装半透 : Mtl_Char_FLTrans
{
	technique
	{
		pass
		{
			alpha_rejection greater 220
		}
		pass
		{
