material 骑乘230816周年庆红色战马 : Mtl_OutlineCtrl_FlowLight
{
	technique
	{
		pass
		{
			alpha_rejection greater 200
		}
		pass
		{
			emissive 0.500000 0.500000 0.5000000   
			fragment_program_ref Model_OutlineCtrl_FlowLight_PS
			{
				param_named flowFactor float4 2.0 -2.0 0 -5
				param_named outlinePow float2 4.0 0.0
				param_named outlineColor float4 1 1 1 2.0
			}
        	}
    	}
	set_texture_alias <baseTexture> tga_骑乘230816周年庆红色战马.dds
	set_texture_alias <ctlTex> jpg_骑乘230816周年庆红色战马遮罩.dds 
	set_texture_alias <_Reflection> jpg_骑乘230816周年庆红色战马流光.dds
        set_texture_alias <outlineCtrlTexture> tga_骑乘230816周年庆红色战马边缘光.dds 
}

