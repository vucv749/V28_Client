material W_hair01_2025七夕聂小倩09 : Mtl_Character_FlowLight
{
	technique
	{
		pass
		{
			emissive 0.500000 0.500000 0.500000   
			fragment_program_ref Character_FlowLight
			{
				param_named flowFactor float4 1.0 2.0 0 -5
			}
        }
    }
	set_texture_alias <baseTexture> tga_W_hair01_2025七夕聂小倩09.dds
	set_texture_alias <ctlTex> jpg_W_hair01_2025七夕聂小倩09遮罩.dds 
	set_texture_alias <_Reflection> jpg_N_cloth_2025七夕聂小倩流光暖.dds
}

