			fragment_program_ref PostFilters/Compositor/RadialBlurHLSL_fp
			{
				param_named_auto vvp viewport_size
				param_named fStrength float 1
				param_named fUnblured float 0.1
			}

			texture_unit
			{
				tex_coord_set 0
				tex_address_mode clamp
				filtering bilinear
			}
		}
	}
}

