material 女主角头饰李师师 : Mtl_Character_FlowLight
{
    technique
    {
        pass
        {
            emissive 0.500000 0.500000 0.500000   
	     fragment_program_ref Character_FlowLight
		{
		      param_named flowFactor float4 3.0 3.0 0 4
		 }         
        }
    }
	set_texture_alias <baseTexture> tga_女主角头饰李师师.dds
	set_texture_alias <ctlTex> tga_女主角头饰李师师流光.dds 
	set_texture_alias <_Reflection> jpg_李师师流光贴图.dds
}


