material boss211223朱雀 : Mtl_Outline_FlowLight
{
	technique
	{
		pass
		{
			alpha_rejection greater 220
		}
		pass
		{
			emissive 0.500000 0.500000 0.500000  
			fragment_program_ref Model_Outline_FlowLight_PS
			{
				param_named flowFactor float4 -1.0 1.0 -5 0
				param_named outlinePow float2 4.0 0.0
				param_named outlineColor float4 0.89 0.22 0.22 1.5
			}
        	}
    	}
	set_texture_alias <baseTexture> tga_珍兽211223朱雀.dds
	set_texture_alias <ctlTex> jpg_珍兽211223朱雀遮罩.dds
	set_texture_alias <_Reflection> jpg_流光暖.dds
}
