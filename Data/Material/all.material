material 新雁门关_崖边树树叶:  LSTree
{
	technique
	{
		pass
		{
			emissive 0.2 0.2 0.2 1
                        alpha_rejection greater 95
                 vertex_program_ref Model_VsAnimation_VS
		{
	               param_named vsAniFactor float4 90 1 1 90
                       param_named vsWindStrength float 10
		 }
		}
	}
		 set_texture_alias <baseTexture> 新雁门关/tga_新雁门关_崖边树树叶.dds

}


