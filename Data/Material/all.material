material WaveGrassTemplate
{
	technique
	{
		pass
		{
			alpha_rejection greater 128

			vertex_program_ref WaveGrass_VS
			{
			}

			fragment_program_ref WaveGrass_PS
			{
			}
			
			texture_unit texColor
			{
				filtering linear linear none
			}
		}
	}
	
	technique
	{
		lod_index 1
		pass
		{
			alpha_rejection greater 128

			vertex_program_ref WaveGrass_NoAnim_VS
			{
			}

			fragment_program_ref WaveGrass_PS
			{
			}

			texture_unit texColor
			{
				filtering linear linear none
			}
		}

	}
}

material WaveGrassTemplateNew
{
	technique
	{
		pass
		{
			alpha_rejection greater 128

			vertex_program_ref WaveGrass_RandomTex_VS
			{
			}

			fragment_program_ref WaveGrass_PS
			{
			}
			
			texture_unit texColor
			{
				filtering linear linear none
			}
			
			texture_unit
			{
				texture <wavenoise>
				shader_type vs
				filtering linear linear none
				sampler_index 0
			}
		}
	}
	
	technique
	{
		lod_index 1
		pass
		{
			alpha_rejection greater 128

			vertex_program_ref WaveGrass_NoAnim_VS
			{
			}

			fragment_program_ref WaveGrass_PS
			{
			}

			texture_unit texColor
			{
				filtering linear linear none
			}
		}

	}
}



