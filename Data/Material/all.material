material npc花车_2025周年庆特效片亮 : Mtl_Model_TwoTex_Tex2_ColorX4

{
	set_texture_alias <baseTexture> jpg_npc花车_2025周年庆特效片亮蒙版.dds
	set_texture_alias <scrollTex> png_npc花车_2025周年庆特效片亮.dds
	technique
	{
		pass
		{
		   emissive 0.500000 0.500000 0.500000
                    fog_override true none
			scene_blend add
			depth_write off
			texture_unit scrollTex

			{
					scroll 0.47 0.0
					scroll_anim 0.3 0
			}
			
		}
