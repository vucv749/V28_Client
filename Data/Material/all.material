material g01_wd_¶Ï±Û¶ÉÉú_B_3 : Mtl_Particle_Dissolve
{
	set_texture_alias <baseTexture> tga_cq½¥±ä2.dds
	set_texture_alias <dissolveTexure> tga_z_dissolve_04.dds
	technique
	{
		pass
		{
			scene_blend src_alpha one
			cull_hardware none
			fragment_program_ref Particle_Dissolve_PS
			{
				//param_named blocks float4 1 1 1 1
				param_named dissolveClip float 1
				param_named dissolveColorA float4 1 0 0 1
				param_named dissolveColorB float4 1 1 0 1
				param_named dissolveParams float4 0.05 0.005 0.02 0.01
				param_named dissolveSoftEdgeWidth float 0
				param_named dissolveUVRepeat float2 1 1
				//param_named useRibbon float4 0 0 0 0
				//param_named useUDirection float4 0 0 0 0
				//param_named widthRatio float4 0 0 0 0
			}
			texture_unit
			{
					scale 0.1 1
			}
		}
	}
}
