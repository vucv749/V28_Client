material npc三生石20150112_01
{
	technique
	{
		pass
		{
			ambient 0 0 0 1
			diffuse 0 0 0 1
			scene_blend add
			depth_write off
			cull_hardware none
			fog_override true none

			texture_unit
			{
				texture png_effect510_0300.dds
				colour_op_ex modulate_x2 src_texture src_current
				colour_op_multipass_fallback dest_colour zero
				rotate 80
				scroll 0.866002 0.733987
				scroll_anim 0 0.6
			}
		}

	}

}

