material TLBB/StatsBlockBorder
{
	technique
	{
		pass
		{
			lighting off
			scene_blend alpha_blend
			depth_check off

			texture_unit
			{
				texture New_Ogre_Border.png
			}
		}
	}
}
material TLBB/StatsBlockCenter
{
	technique
	{
		pass
		{
			lighting off
			scene_blend alpha_blend
			depth_check off

			texture_unit
			{
				texture TLBB_Border_Center.png
			}
		}
	}
}
material TLBB/MapSearchLight
{
	technique
	{
		pass
		{
			lighting off
			scene_blend alpha_blend

			texture_unit
			{
				texture MapSearchLight.tga
				tex_address_mode clamp
			}
		}
	}
}

material TLBB/UIModelBackground
{
	technique
	{
		pass
		{
			lighting off
			depth_write off

			texture_unit
			{				
				tex_address_mode clamp
			}
		}
	}
}

//---------------------------    Anti-Aliasing Materials     -----------------------//

//////////////////////////////////////////////////////////////////////////////////////
//																																									//
//																			M.L.A.A.																		//
//															Morphological Anti-Aliasing													//
//////////////////////////////////////////////////////////////////////////////////////

vertex_program PostFilter/AntiAliasing/vp_MLAA_VS hlsl
{
	source AntiAlias.hlsl
	entry_point MLAA_VS
	target vs_3_0
	
	default_params
	{
		param_named_auto worldViewProj worldviewproj_matrix
	}
}

fragment_program PostFilter/AntiAliasing/fp_MLAA_EdgeDetectionLuminancePS hlsl
{
	source AntiAlias.hlsl
	entry_point MLAA_EdgeDetectionLuminancePS
	target ps_3_0
	
	default_params
	{
		param_named_auto cTargetSize	viewport_size
	}
}

fragment_program PostFilter/AntiAliasing/fp_MLAA_EdgeDetectionDepthPS hlsl
{
	source AntiAlias.hlsl
	entry_point MLAA_EdgeDetectionDepthPS
	target ps_3_0
	
	default_params
	{
