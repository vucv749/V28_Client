			{
				param_named flowFactor float4 1.0 2.0 0 -5
			}
        }
    }
	set_texture_alias <baseTexture> tga_W_hair01_2025七夕聂小倩09.dds
	set_texture_alias <ctlTex> jpg_W_hair01_2025七夕聂小倩09遮罩.dds 
