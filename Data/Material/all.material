material top_2025情人节银狼面具特效片 : Mtl_Model_TwoTex_Tex2_ColorX4

{
	set_texture_alias <baseTexture> jpg_top_2025情人节银狼面具特效片蒙版.dds
	set_texture_alias <scrollTex> png_top_2025情人节银狼面具特效片.dds
	technique
	{
		pass
		{
		   emissive 0.500000 0.500000 0.500000
                    fog_override true none
			scene_blend zero one_minus_src_colour
			depth_write off
			texture_unit scrollTex

			{
					scroll 0.4 0
					scroll_anim 0.4 0.02
			}
			
		}
	}
}

