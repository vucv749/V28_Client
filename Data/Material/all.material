material npc_2025情人节月神特效片 : Mtl_Model_TwoTex_Tex2_ColorX4

{
	set_texture_alias <baseTexture> jpg_npc_2025情人节月神特效片蒙版.dds
	set_texture_alias <scrollTex> png_npc_2025情人节月神特效片.dds
	technique
	{
		pass
		{
		   emissive 0.500000 0.500000 0.500000
                    fog_override true none
			scene_blend add
			depth_write off
			texture_unit scrollTex

			{
					scroll 0.47 0.0
					scroll_anim 0.3 0
			}
			
		}
	}
}
