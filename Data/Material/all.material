material W_cloth_2024白晶晶npc : Mtl_OutlineCtrl_FlowLight
{
	technique
	{
		pass
		{
			alpha_rejection greater 180
		}
		pass
		{
			emissive 0.500000 0.500000 0.5000000   
			fragment_program_ref Model_OutlineCtrl_FlowLight_PS
			{
				param_named flowFactor float4 2.0 3.0 -1 4
				param_named outlinePow float2 3.0 0.0
				param_named outlineColor float4 1 1 1 1.5
			}
        	}
    	}
	set_texture_alias <baseTexture> tga_W_cloth_2024白晶晶npc.dds
	set_texture_alias <ctlTex> jpg_W_cloth_2024白晶晶遮罩npc.dds 
	set_texture_alias <_Reflection> jpg_W_cloth_2024白晶晶流光npc.dds
        set_texture_alias <outlineCtrlTexture> tga_W_cloth_2024白晶晶边缘光npc.dds 
}

material W_cloth_2024白晶晶npc半透 : Mtl_OutlineCtrl_FlowLight
{
	technique
	{
		pass
		{
			alpha_rejection greater 200
		}
		pass
		{
			emissive 0.500000 0.500000 0.5000000   
			fragment_program_ref Model_OutlineCtrl_FlowLight_PS
			{
				param_named flowFactor float4 2.0 3.0 -1 4
				param_named outlinePow float2 3.0 0.0
				param_named outlineColor float4 1 1 1 1.5
			}
        	}
    	}
	set_texture_alias <baseTexture> tga_W_cloth_2024白晶晶npc.dds
	set_texture_alias <ctlTex> jpg_W_cloth_2024白晶晶遮罩npc.dds 
	set_texture_alias <_Reflection> jpg_W_cloth_2024白晶晶流光npc.dds
        set_texture_alias <outlineCtrlTexture> tga_W_cloth_2024白晶晶边缘光npc.dds 
}
