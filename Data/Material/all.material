material npc_2025情人节月神 : Mtl_OutlineCtrl_FlowLight
{
	technique
	{
		pass
		{
			alpha_rejection greater 180
		}
		pass
		{
			emissive 0.500000 0.500000 0.5000000   
			fragment_program_ref Model_OutlineCtrl_FlowLight_PS
			{
				param_named flowFactor float4 2.0 2.0 3 6
				param_named outlinePow float2 3.0 0.0
				param_named outlineColor float4 1 1 1 1.5
			}
        	}
    	}
	set_texture_alias <baseTexture> tga_npc_2025情人节月神.dds
	set_texture_alias <ctlTex> jpg_npc_2025情人节月神遮罩.dds 
	set_texture_alias <_Reflection> jpg_npc_2025情人节月神流光冷.dds
        set_texture_alias <outlineCtrlTexture> tga_npc_2025情人节月神边缘光.dds 
}
