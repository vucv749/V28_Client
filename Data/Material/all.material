			fragment_program_ref Model_Outline_PS
			{
					param_named outlinePow float2 2.0 0.0
				param_named outlineColor float4 0.15 0.25 1 2
			}
        	}
    	}

	set_texture_alias <baseTexture> tga_男主角冰雪时装_残影.dds


