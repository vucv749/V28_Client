material 女主角异域时装 : Mtl_Character_FlowLight
{
	technique
	{
		pass
		{
			emissive 0.500000 0.500000 0.500000   
			fragment_program_ref Character_FlowLight
			{
				param_named flowFactor float4 1.0 2.0 1 -5
			}
        }
    }
	set_texture_alias <baseTexture> tga_女主角异域时装.dds
	set_texture_alias <ctlTex> jpg_女主角异域时装遮罩.dds 
	set_texture_alias <_Reflection> jpg_主角异域时装流光.dds
}

