	set_texture_alias <baseTexture> png_z_uv_001.dds
	set_texture_alias <scrollTex> png_鼠年珍兽异域光圈01.dds
	technique
	{
		pass
		{
			scene_blend one one
			depth_write off
			cull_hardware none
			texture_unit
			{
					scale 0.5 1
					scroll 0.690918 0.863344
					scroll_anim 0.1 -0.6
			}
			texture_unit scrollTex
			{
				tex_address_mode clamp
			}
		}
	}
}
