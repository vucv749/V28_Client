material 骑乘20210628七夕船 : Mtl_Character_FlowLight_Uv
{
	 technique
    {
				pass
				{					
						emissive 0.5 0.5 0.5            
            alpha_rejection greater 128							
						fragment_program_ref Character_FlowLight_Uv
		      	{
		      				param_named flowFactor float4 3.0 -3.0 1.0 2.0
		      	}
				
        }
    }
	set_texture_alias <baseTexture> tga_骑乘20210628七夕船.dds
	set_texture_alias <ctlTex> jpg_骑乘20210628七夕船遮罩.dds
	set_texture_alias <_Reflection> jpg_骑乘20210628七夕船流光.dds
}

