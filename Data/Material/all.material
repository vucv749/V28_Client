	set_texture_alias <baseTexture> jpg_npc许愿池水面蒙版.dds
	set_texture_alias <scrollTex> png_npc许愿池水面贴图.dds
	technique
	{
		pass
		{
		   emissive 0.500000 0.500000 0.500000
			scene_blend add
			depth_write off
			texture_unit scrollTex

			{
					scroll 0.3 0
					scroll_anim 0.15 0
			}
			
		}
	}
}

