material 男主角三兔共耳春节套装 : Mtl_Character_FlowLight
{
	technique
	{
		pass
		{
			emissive 0.500000 0.500000 0.500000   
			fragment_program_ref Character_FlowLight
			{
				param_named flowFactor float4 -2.0 2.0 0 5
			}
        }
    }
	set_texture_alias <baseTexture> tga_男主角三兔共耳春节套装.dds
	set_texture_alias <ctlTex> jpg_男主角三兔共耳春节套装遮罩.dds 
	set_texture_alias <_Reflection> jpg_主角三兔共耳春节套装流光.dds
}

